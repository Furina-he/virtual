X5 5 a2 14 7 LS_IN
X6 6 b2 14 7 LS_IN
X8 8 a3 14 7 LS_IN
X9 9 b3 14 7 LS_IN
X11 11 a4 14 7 LS_IN
X12 12 b4 14 7 LS_IN
Aadc [a1 b1 a2 b2 a3 b3 a4 b4] [da1 db1 da2 db2 da3 db3 da4 db4] LS_ADC
An1 [da1 db1] dy1 LS02_NOR
An2 [da2 db2] dy2 LS02_NOR
An3 [da3 db3] dy3 LS02_NOR
An4 [da4 db4] dy4 LS02_NOR
Adac [dy1 dy2 dy3 dy4] [l1 l2 l3 l4] LS_DAC
X1 l1 1 14 7 LS_OUT
X4 l2 4 14 7 LS_OUT
X10 l3 10 14 7 LS_OUT
X13 l4 13 14 7 LS_OUT
.model LS02_NOR d_nor(rise_delay=8e-9 fall_delay=8e-9)
.ends SN74LS02

