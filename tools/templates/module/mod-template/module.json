{
  "id": "mod-template",
  "name": "实训挂箱标准模板",
  "form": "box",
  "model": "module.glb",
  "netlist": "module.cir",
  "jacks": [
    { "id": "IN_P", "label": "输入+", "kind": "banana4", "polarityHint": "+" },
    { "id": "IN_N", "label": "输入−", "kind": "banana4", "polarityHint": "-" },
    { "id": "OUT_A", "label": "输出A", "kind": "banana4" },
    { "id": "OUT_B", "label": "输出B", "kind": "banana4" }
