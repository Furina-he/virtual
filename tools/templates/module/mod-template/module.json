    {
      "id": "K1",
      "label": "支路开关 K1",
      "kind": "switch",
      "param": "k1",
      "steps": [0, 1],
      "stepLabels": ["断开", "闭合"],
      "targets": [{ "element": "RK1", "values": [1000000000000, 0.001] }],
      "unit": "",
      "default": 1
    }
  ],
  "indicators": [],
  "commonNets": [["IN_N", "OUT_B"]]
