{
  "name": "virtual-ee-lab",
  "productName": "电工电子技术虚拟仿真实训",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --win nsis --publish never",
    "build:app": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "content:lint": "node tools/content-lint.ts",
    "assets:fetch": "node tools/assets/fetch-sources.ts",
    "assets:build": "node tools/assets/build.ts",
    "assets:lint": "node tools/assets/lint.ts",
    "test:golden": "vitest run tests/golden"
  },
  "dependencies": {
    "@dnd-kit/react": "0.5.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dseg": "0.46.0",
    "katex": "0.19.1",
    "koffi": "3.3.4",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hotkeys-hook": "5.3.3",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.8",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zundo": "2.3.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "tunnel-rat>zustand": "5.0.16"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi"
    ]
  }
}
